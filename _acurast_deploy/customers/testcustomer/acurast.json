{
  "projects": {
    "monitor": {
      "projectName": "monitor-testcustomer",
      "fileUrl": "monitor.js",
      "network": "canary",
      "runtime": "NodeJS",
      "onlyAttestedDevices": true,
      "enableDevtools": true,
      "assignmentStrategy": {
        "type": "Single"
      },
      "execution": {
        "type": "onetime",
        "maxExecutionTimeInMs": 60000
      },
      "maxAllowedStartDelayInMs": 10000,
      "usageLimit": {
        "maxMemory": 0,
        "maxNetworkRequests": 0,
        "maxStorage": 0
      },
      "numberOfReplicas": 1,
      "requiredModules": [],
      "minProcessorReputation": 0,
      "maxCostPerExecution": 100000000000,
      "includeEnvironmentVariables": [
        "TARGET_URL",
        "ALERT_WEBHOOK",
        "CHECK_INTERVAL_MS"
      ],
      "processorWhitelist": [],
      "mutability": "Immutable"
    }
  }
}