# ── Broker selection ───────────────────────────────────────
BROKER=kraken

# ── Kraken Spot ────────────────────────────────────────────
# Use a dedicated key. Never grant withdrawal permissions.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_TIER=starter

# ── SAFETY / LIVE EXECUTION ────────────────────────────────
# Defaults are locked. Live execution requires ALL of these to be aligned.
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false
DRY_RUN=true
LIVE_EXECUTION_ARMED=false
LIVE_RISK_ACKNOWLEDGEMENT=

# ── Market ─────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME_MINUTES=60
LOOKBACK_BARS=500

# ── Risk ───────────────────────────────────────────────────
STRATEGY_EQUITY_USD=25
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
MAX_DAILY_LOSS_FRACTION=0.03
MAX_DRAWDOWN_FRACTION=0.10
MAX_ORDERS_PER_DAY=3
COOLDOWN_MINUTES=90
MIN_ORDER_NOTIONAL_USD=1.00

# ── Data freshness ─────────────────────────────────────────
MAX_BAR_AGE_MULTIPLE=3.0
MAX_CLOCK_SKEW_SECONDS=30

# ── Market quality ─────────────────────────────────────────
MAX_SPREAD_BPS=50
MIN_DOLLAR_VOLUME=1000000

# ── Transport ──────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# ── COO strategy ───────────────────────────────────────────
FAST_EMA=20
SLOW_EMA=50
REGIME_EMA=200
RSI_PERIOD=14
RSI_MIN=45
RSI_MAX=68
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
BREAKOUT_LOOKBACK=20
VOLUME_LOOKBACK=20
MIN_VOLUME_RATIO=1.10
COO_ENTRY_SCORE=72
COO_EXIT_SCORE=65
COO_MIN_ATR_FRACTION=0.002
COO_MAX_ATR_FRACTION=0.08
COO_CONFIDENCE_FLOOR=0.60

# ── State paths ────────────────────────────────────────────
JOURNAL_PATH=logs/decisions.jsonl
AUDIT_LOG_PATH=logs/audit.jsonl
IDEMPOTENCY_PATH=logs/orders.json
NONCE_STATE_PATH=logs/nonce.json
MANAGED_POSITION_PATH=logs/managed_position.json
